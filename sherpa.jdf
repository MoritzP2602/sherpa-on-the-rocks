Executable  = /bin/bash
USERNAME    = $ENV(USER)
LOGDIR      = condor_output
MAXRUNTIME  = 86400
SHERPA      = /PATH/TO/SHERPA/INSTALLATION/bin/Sherpa
Arguments   = /home/$(USERNAME)/sherpa-on-the-rocks/run_sherpa.sh $(SHERPA) $(folder) $(LOGDIR) $(Cluster) $(Process) $(MAXRUNTIME)
+MaxRuntime = $(MAXRUNTIME)
max_idle    = 1000

Log         = $(LOGDIR)/job.$(Cluster).$(Process).log

Queue folder from runs.txt
