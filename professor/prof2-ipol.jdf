executable   = /bin/bash
USERNAME     = $ENV(USER)
LOGDIR       = condor_output
MAXRUNTIME   = $ENV(MAXRUNTIME:86400)
NPROC        = $ENV(NPROC:1)
PROF2_IPOL   = /PATH/TO/PROFESSOR/INSTALLATION/bin/prof2-ipol
RIVET_ENV    = /PATH/TO/RIVET/ENVIRONMENT/rivetenv.sh
arguments    = /home/$(USERNAME)/sherpa-on-the-rocks/professor/run_prof2-ipol.sh $(PROF2_IPOL) $(RIVET_ENV) $(NPROC) $(LOGDIR) $(Cluster) $(Process) $(MAXRUNTIME) $(args)
+MaxRuntime  = $INT(MAXRUNTIME)
request_cpus = $INT(NPROC)
max_idle     = 1000

Log          = $(LOGDIR)/job.$(Cluster).$(Process).log

Queue args from ipols.txt
